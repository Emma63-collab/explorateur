# ── URL de l'API PHP (backend) ──────────────────────────────
# ⚠️ CE FICHIER N'EST PLUS LE MOYEN RECOMMANDÉ DE CONFIGURER L'API.
# Utilise plutôt frontend/public/config.json (voir config.example.json
# dans le même dossier) : il se modifie SANS recompiler le projet.
# VITE_API_URL n'est gardé ici que comme repli si config.json est
# introuvable au chargement de la page.
#
# Adapte selon le nom du dossier dans htdocs et le port Apache.
#
# Dossier explorateur/, Apache port 80 (défaut XAMPP classique) :
VITE_API_URL=http://localhost/explorateur/backend
#
# Racine htdocs, Apache port 8080 (souvent sur certaines machines) :
# VITE_API_URL=http://localhost:8080/backend
#
# Racine htdocs, Apache port 80 :
# VITE_API_URL=http://localhost/backend

# ── Chemin de base Vite (build de production uniquement) ────
# Doit correspondre à l'URL Apache du dossier dist/.
#
# Build sous http://localhost/explorateur/frontend/dist/ :
VITE_BASE=/explorateur/frontend/dist/
#
# Build à la racine http://localhost/ (ou :8080/) :
# VITE_BASE=/
#
# En développement (npm run dev), ce réglage est ignoré (base = /).
